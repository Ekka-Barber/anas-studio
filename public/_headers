# Cloudflare Pages response headers (D32). Next copies this file into `out/`.
# HSTS is the soon page's own value, so moving the domain to Pages keeps it;
# no includeSubDomains or preload until the owner approves either.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The admin: never indexed, never cached, never framed. `/admin/*` does not
# match `/admin` itself, so both are listed.
/admin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY

/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY

# P02: the book's preview is read on /book; the PDF itself is not a page to
# index on its own. `/book/*` does not match the page `/book`, only the PDF.
# Its name stays the same when the preview is replaced, so it is cached for a
# day, like the files below.
/book/*
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=86400

# P08: where the payment page sends the buyer back. The order number is in the
# query, so the page is never indexed, cached or passed on in a Referer.
/checkout/return
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Robots-Tag: noindex

# P08: the buyer's order page and the two links of the availability mails. Their
# addresses carry a token in the fragment, so no page is indexed, cached or passed
# on in a Referer.
/orders
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Robots-Tag: noindex

/notify/*
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Robots-Tag: noindex

# Fonts, images and brand files are not content-addressed: a file keeps its
# name when it is replaced (images/v2/anas-portrait-1200.webp is rewritten in
# place), so a year of `immutable` would serve the old file for a year. A day,
# then the browser asks again. Never `immutable` for these.
/fonts/*
  Cache-Control: public, max-age=86400

/images/*
  Cache-Control: public, max-age=86400

/brand/*
  Cache-Control: public, max-age=86400

# Built assets are content-hashed and safe to cache for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
