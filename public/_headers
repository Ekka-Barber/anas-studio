# Cloudflare Pages response headers (D32). Next copies this file into `out/`.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The admin: never indexed, never cached, never framed. `/admin/*` does not
# match `/admin` itself, so both are listed.
/admin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY

/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY

# Built assets are content-hashed and safe to cache for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
