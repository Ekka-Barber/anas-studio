{
  "name": "anas-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.9.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "opennextjs-cloudflare preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:db": "vitest run --mode db --passWithNoTests",
    "test:e2e": "playwright test",
    "check:frozen": "node scripts/check-frozen.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:budgets": "node scripts/check-budgets.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run check:frozen && pnpm run check:copy && pnpm run test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:env": "node scripts/local-env.mjs",
    "db:import": "node scripts/import-content.mjs",
    "bootstrap:owner": "node scripts/bootstrap-owner.mjs",
    "cf-typegen": "wrangler types cloudflare-env.d.ts --env-interface CloudflareEnv --env-file=wrangler-empty.env"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.1",
    "next": "16.3.5",
    "pg": "8.20.0",
    "pg-cloudflare": "1.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/pg": "8.20.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "sharp": "0.35.4",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "wrangler": "4.136.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "workerd"
    ]
  }
}
