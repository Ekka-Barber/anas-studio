{
  "name": "anas-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.9.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node -e \"require('node:fs').rmSync('.next/cache/fetch-cache', { recursive: true, force: true })\" && next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:db": "vitest run --mode db --passWithNoTests",
    "test:e2e": "playwright test",
    "check:frozen": "node scripts/check-frozen.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:budgets": "node scripts/check-budgets.mjs",
    "check:export": "node scripts/check-export.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run check:frozen && pnpm run check:copy && pnpm run test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:env": "node scripts/local-env.mjs",
    "db:import": "node scripts/import-content.mjs",
    "db:demo-catalog": "node scripts/seed-demo-catalog.mjs",
    "bootstrap:owner": "node scripts/bootstrap-owner.mjs",
    "backup": "node scripts/backup.mjs",
    "restore-check": "node scripts/restore-check.mjs"
  },
  "dependencies": {
    "@lexical/link": "0.51.0",
    "@lexical/list": "0.51.0",
    "@lexical/react": "0.51.0",
    "@lexical/rich-text": "0.51.0",
    "@supabase/supabase-js": "2.117.1",
    "lexical": "0.51.0",
    "next": "16.3.5",
    "page-flip": "2.0.7",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-easy-crop": "6.2.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/pg": "8.20.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "image-size": "2.0.4",
    "pg": "8.20.0",
    "sharp": "0.35.4",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
