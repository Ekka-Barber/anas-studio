# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# codegraph local index — regenerable
/.codegraph/

# archived superseded versions — cold storage, out of agent context
/_archive/

# python bytecode
__pycache__/

# secrets — never commit; .env.example is the tracked template
.env
.env.*
!.env.example

# Local single-writer coordination, never a committed package artifact.
/.anasaq-execution.lock

# Node and build output (P00).
/node_modules/
/.next/
/out/
*.tsbuildinfo

# Local Worker secrets consumed by `wrangler dev`. Never committed.
.dev.vars
.dev.vars.*

# Playwright transient run output; kept evidence lives under artifacts/.
/test-results/

# Transcoded video derivatives (P01, scripts/prepare-media.mjs): large
# binaries regenerated from BOOK_ASSETS/, not committed. R2 hosting is a
# later task (see docs/design-direction.md). The manifest describing what
# would be uploaded IS committed, so it stays out of this ignore rule.
/public/media/*
!/public/media/manifest.json
