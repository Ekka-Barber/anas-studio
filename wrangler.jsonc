{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anas-studio",

  // `worker-entry.ts` wraps the generated OpenNext handler: it gates
  // `POST /api/revalidate` (I20/I21, D29) before delegating everything else.
  // The generated bundle is reached through the `alias` below so that
  // `pnpm typecheck` does not depend on build output existing.
  "main": "worker-entry.ts",
  "alias": {
    "open-next-worker": "./.open-next/worker.js"
  },

  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Supabase PostgreSQL through Hyperdrive. Query caching is disabled on the
  // Hyperdrive configuration itself so authorization, publication and inventory
  // reads always reach the database.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "f93334ce5f554313b81ed0afdb003461"
    }
  ],

  // Private bucket: r2.dev public access is disabled; a later package owns
  // access-controlled media serving.
  //
  // I20/D27: `NEXT_INC_CACHE_R2_BUCKET` is a second, separate bucket — the
  // OpenNext Cloudflare adapter's incremental cache for public ISR pages
  // (`open-next.config.ts`), not media. Binding name is fixed by the adapter
  // (`node_modules/@opennextjs/cloudflare/dist/api/overrides/incremental-cache/r2-incremental-cache.js`).
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "anas-studio-media-test"
    },
    {
      // P05: public derivatives (`m/<id>/<width>.webp`) served from an
      // isolated origin. The bucket does not exist yet — the owner's P11
      // deploy step creates it; local development uses the simulation.
      "binding": "MEDIA_PUBLIC",
      "bucket_name": "anas-studio-media-public-test"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      // Does not exist yet: the orchestrator's tooling could not create it, so
      // the owner's deploy step creates it. bucket_name needs no id and is
      // already final.
      "bucket_name": "anas-studio-next-cache"
    }
  ],

  // I20/D27: the D1 tag cache for on-demand revalidation (`revalidateTag`/
  // `revalidatePath`), read by the R2 incremental cache above before serving
  // a hit. Binding name is fixed by the adapter
  // (`overrides/tag-cache/d1-next-tag-cache.js`). No queue binding: per
  // https://opennext.js.org/cloudflare/caching (fetched 2026-09-23), "A queue
  // must be setup for projects using Time-Based revalidation. It is not
  // needed when revalidation is not used nor only On-Demand revalidation is
  // used" — this app only ever calls `revalidateTag`/`revalidatePath`, never
  // time-based ISR. No `WORKER_SELF_REFERENCE` service binding either: reading
  // the adapter source, that binding is only consumed by the Durable Object
  // queue and by the Pages Router's `res.revalidate` patch
  // (`durable-objects/queue.js`, `cli/build/patches/plugins/res-revalidate.js`)
  // — this app has neither.
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      // Created by the orchestrator, APAC region, 2026-09-23. The
      // `revalidations` table is created by `opennextjs-cloudflare`'s own
      // `populateCache`/`deploy`/`preview` commands, not by a migration here —
      // see `docs/runtime-spike.md` and `artifacts/acceptance/P00/i20-public-read-path.txt`.
      "database_id": "b29a8934-b98c-4eec-aa05-22649cab90cc",
      "database_name": "anas-studio-tag-cache"
    }
  ],

  // Non-secret configuration only. `REVALIDATE_SECRET` is a Worker secret
  // (`wrangler secret put`), read by `src/app/api/revalidate/route.ts` through
  // `process.env`, never through this `vars` block.
  //
  // P00 spike origin: `https://anas.studio` does not point at this Worker yet.
  // `SITE_URL` is the origin the D29 admin's revalidation call reaches
  // (`src/lib/revalidate.ts`). Worker name `anas-studio`, account subdomain
  // `anas-studio`, both confirmed via the Cloudflare API. The production
  // value (`https://anas.studio`) is used once the custom domain is attached.
  "vars": {
    "SITE_URL": "https://anas-studio.anas-studio.workers.dev"
  },

  // P06: the one Worker Cron Trigger (ARCHITECTURE "Jobs"). Every minute is
  // deliberate — the outbox's own `next_at` backoff and quota checks decide
  // whether anything is actually sent, so a frequent trigger only makes the
  // dispatch latency small. `worker-entry.ts`'s `scheduled` turns it into one
  // authenticated `POST /api/jobs/run` (`JOBS_SECRET` Worker secret); with
  // that secret unset the trigger does nothing.
  "triggers": {
    "crons": ["* * * * *"]
  },

  "observability": {
    "enabled": true
  }
}
