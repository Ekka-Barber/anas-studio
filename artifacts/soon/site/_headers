# The soon page is static: its own files only, one small script, no forms.
# The one outside address is Cloudflare Web Analytics, which the zone adds to
# the page itself (a cookie-less visit count for the owner).
# Not indexed: indexing waits for the launch and the approved search title
# and description (P10). Remove the X-Robots-Tag line to open it.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'none'; style-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Robots-Tag: noindex

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
