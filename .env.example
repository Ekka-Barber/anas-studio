# Names only. Never copy actual credentials into this tracked template.
# Locally, `pnpm db:env` writes `.env.local` and `supabase/functions/.env`
# from the running local stack; nothing here needs filling in by hand.

# --- The static site (Cloudflare Pages build environment, D32) --------------
# Public values only: they are inlined into the built files. Never put a
# secret or service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set to `on` to show the Google button on /admin/sign-in, once Anas supplies
# a Google OAuth client and supabase/config.toml's [auth.external.google] is enabled.
NEXT_PUBLIC_AUTH_GOOGLE=
# The Turnstile site key for the contact form (public).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Edge Function secrets (`supabase secrets set`, D32) --------------------
# SUPABASE_URL and the service-role key are provided to every function by
# Supabase itself and are never set by hand.
# The canonical site URL (https://anas.studio): the contact function accepts
# only this origin, and a non-local value turns on real email and refuses
# test secrets.
SITE_URL=
# Bearer secret the pg_cron outbox job sends to the `outbox` function (the
# same value goes into Vault as `jobs_secret`). Unset means the endpoint does
# not exist.
JOBS_SECRET=
# Salts the contact form's hashed caller key (never store a raw IP).
TOKEN_HASH_PEPPER=
# Outbound email through Resend; unset, the outbox records
# `skipped: EMAIL_NOT_CONFIGURED` instead of sending.
RESEND_API_KEY=
# Display address for every outbound mail, e.g. `Name <user@host>`.
EMAIL_FROM=
# Resend signs its webhooks with Svix: `whsec_<base64>`. Unset means the
# webhook endpoint does not exist.
RESEND_WEBHOOK_SECRET=
# Turnstile's secret, checked server-side against siteverify's action and
# hostname (the site key is NEXT_PUBLIC_TURNSTILE_SITE_KEY above).
TURNSTILE_SECRET_KEY=
# Owner statistics (Cloudflare GraphQL Analytics, read-only token).
ANALYTICS_TOKEN=
CLOUDFLARE_ZONE_ID=
# Local development only, never on the hosted project: the local stack's
# Mailpit as the functions reach it from Docker
# (http://host.docker.internal:54324). Refused for a non-local SITE_URL.
EMAIL_DEV_MAILPIT_URL=

# Moyasar is pending E02 and does not block launch (D34). Never default to
# live payment mode.
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
PAYMENTS_MODE=
MFA_ENCRYPTION_KEY=
SENTRY_DSN=

# --- Vault (hosted database, set once by the owner, D32) --------------------
# Not environment variables: `select vault.create_secret('<value>', '<name>')`.
# pages_deploy_hook  the Cloudflare Pages deploy hook URL (site rebuilds)
# functions_url      https://<project-ref>.supabase.co/functions/v1
# jobs_secret        the same value as JOBS_SECRET above

# --- Supabase CLI and migrations --------------------------------------------
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# Migration credentials only (the non-pooled session/direct endpoint).
# Nothing at runtime connects to the database with a password (D32).
DATABASE_URL=

# --- Local only ----------------------------------------------------------
# Local Supabase stack only (`supabase/config.toml`); never a hosted Google
# credential.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Required by `pnpm test:db`; the run refuses any non-local DATABASE_URL.
TEST_ENV=

# Client-owned Cloudflare account, least-privilege tokens, for DNS and Pages
# setup only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
