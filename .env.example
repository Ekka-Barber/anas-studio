# Names only. Never copy actual credentials into this tracked template.
# Configure the canonical anas.studio URL privately when needed.
SITE_URL=
PAYLOAD_SECRET=

# Client-owned Cloudflare account; use least-privilege tokens.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Planned server-only analytics credential name.
ANALYTICS_TOKEN=
# Hyperdrive CMS/finance and R2 Worker bindings are configured in P00,
# not stored as credential strings in this file. The four R2_* names below are
# also required by the node admin target (I19/D27), where the Worker's R2
# binding does not exist and `@payloadcms/storage-s3` reaches R2's S3 API
# with them instead.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=

# Node admin target only (I19/D27): `RUNTIME_TARGET=node` is set by the Docker
# image/VM, never here. When it is set, these become required:
RUNTIME_TARGET=
# The runtime transaction-pooler URL, separate from the migration DATABASE_URL
# below. Never reuse DATABASE_URL for this — see the D26 note under it.
CMS_DATABASE_URL=
# The admin's own origin, e.g. https://admin.anas.studio. Becomes Payload's
# serverURL and the cookie-auth CSRF allowlist entry.
ADMIN_URL=

# One synthetic Supabase preview project; local Docker is primary.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# Migration credentials only; do not use a privileged URL for runtime requests.
# D26: this is the separate non-pooled session/direct endpoint. Runtime requests
# go through the HYPERDRIVE Worker binding, whose origin is the transaction
# pooler. The two are never interchanged.
DATABASE_URL=

# Local development only. wrangler points the HYPERDRIVE binding at this URL
# when simulating the Worker locally, so `pnpm dev` and `pnpm preview:worker`
# exercise the binding path against a disposable local PostgreSQL container.
# wrangler 4.136 also still accepts the legacy WRANGLER_* prefix.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# Required by `pnpm test:db`; the run refuses any non-local DATABASE_URL.
TEST_ENV=

RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Moyasar is pending E02. Never default to live payment mode.
MOYASAR_SECRET_KEY=
# Planned Moyasar webhook credential name.
WEBHOOK_SECRET=
PAYMENTS_MODE=
JOBS_SECRET=
TOKEN_HASH_PEPPER=
MFA_ENCRYPTION_KEY=
SENTRY_DSN=
