# Names only. Never copy actual credentials into this tracked template.
# Configure the canonical anas.studio URL privately when needed.
SITE_URL=
# I20/D27: bearer secret for `POST /api/revalidate` on the Worker. The Worker
# checks it (`wrangler secret put REVALIDATE_SECRET`); the D29 admin also
# needs it to call the Worker back after a publish-affecting save/delete
# (`src/lib/revalidate.ts`). Unset on either side means the call/endpoint does
# not exist — there is no open fallback.
REVALIDATE_SECRET=

# Client-owned Cloudflare account; use least-privilege tokens.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Planned server-only analytics credential name.
ANALYTICS_TOKEN=
# The Hyperdrive and R2 Worker bindings are configured in wrangler.jsonc, not
# stored as credential strings in this file.

# P05: the production isolated origin for public media — a custom domain on
# the public bucket (MEDIA_PUBLIC in wrangler.jsonc) that the owner sets up in
# P11. Inlined into the bundles at build time (NEXT_PUBLIC_*): a build without
# it serves media from the local stand-in route /media, so P11 must build with
# the real origin set. Unset locally.
NEXT_PUBLIC_MEDIA_ORIGIN=

# Public Supabase Data API — browser admin (path 1) and public Worker reads
# with the publishable key (path 2), see PLANS/ARCHITECTURE.md "Three data
# paths". Never put a secret or service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# One synthetic Supabase preview project; local Docker is primary.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# Migration credentials only; do not use a privileged URL for runtime requests.
# D26: this is the separate non-pooled session/direct endpoint. Runtime
# requests go through the HYPERDRIVE Worker binding, whose origin is the
# transaction pooler, as `app_server` (EXECUTE-only on named functions). The
# two are never interchanged.
DATABASE_URL=

# Local development only. wrangler points the HYPERDRIVE binding at this URL
# when simulating the Worker locally, so `pnpm dev` and `pnpm preview:worker`
# exercise the binding path against the local Supabase stack as `app_server`.
# Shape: postgresql://app_server:<local-only password>@127.0.0.1:54322/postgres
# wrangler 4.136 also still accepts the legacy WRANGLER_* prefix.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# Local Supabase stack only (`supabase/config.toml`); optional until a client
# exists. Never a hosted Google credential.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Set to `on` to show the Google button on /admin/sign-in, once Anas supplies
# a Google OAuth client and supabase/config.toml's [auth.external.google] is enabled.
NEXT_PUBLIC_AUTH_GOOGLE=

# Required by `pnpm test:db`; the run refuses any non-local DATABASE_URL.
TEST_ENV=

RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Moyasar is pending E02. Never default to live payment mode.
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
PAYMENTS_MODE=
JOBS_SECRET=
TOKEN_HASH_PEPPER=
MFA_ENCRYPTION_KEY=
SENTRY_DSN=
