# Names only. Never copy actual credentials into this tracked template.
# Configure the canonical anas.studio URL privately when needed.
SITE_URL=
PAYLOAD_SECRET=

# Client-owned Cloudflare account; use least-privilege tokens.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Planned server-only analytics credential name.
ANALYTICS_TOKEN=
# Hyperdrive CMS/finance and R2 Worker bindings are configured in P00,
# not stored as credential strings in this file.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=

# One synthetic Supabase preview project; local Docker is primary.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# Migration credentials only; do not use a privileged URL for runtime requests.
DATABASE_URL=

RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Moyasar is pending E02. Never default to live payment mode.
MOYASAR_SECRET_KEY=
# Planned Moyasar webhook credential name.
WEBHOOK_SECRET=
PAYMENTS_MODE=
JOBS_SECRET=
TOKEN_HASH_PEPPER=
MFA_ENCRYPTION_KEY=
SENTRY_DSN=
